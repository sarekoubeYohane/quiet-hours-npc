{
  "$schema": "node_modules/wrangler/config-schema.json",
  // 頂層是本機開發設定；測試站與正式站各在 env 底下，Worker 名稱、D1 與 vars 分開。
  // 本機 D1 存在 .wrangler/state，先跑 `pnpm db:migrate:local` 套用 migration。
  "name": "quiet-hours-npc-local",
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
      "head_sampling_rate": 1,
      "persist": true
    }
  },
  "assets": { "directory": "dist/client", "not_found_handling": "none", "binding": "ASSETS" },
  "vars": { "APP_ENV": "local", "AUTH_ORIGIN": "http://localhost:5173", "GITHUB_ALLOWED_IDS": "89203678" },
  "d1_databases": [
    { "binding": "DB", "database_name": "quiet-hours-npc-local", "database_id": "quiet-hours-npc-local", "migrations_dir": "drizzle" }
  ],
  "env": {
    "test": {
      "name": "quiet-hours-npc-test",
      "vars": { "APP_ENV": "test", "AUTH_ORIGIN": "https://quiet-hours-npc-test.houmengkou.workers.dev", "GITHUB_ALLOWED_IDS": "89203678" },
      "d1_databases": [
        { "binding": "DB", "database_name": "quiet-hours-npc-test-world", "database_id": "ecfd3c90-db4c-493d-88ad-ac8dca661d7a", "migrations_dir": "drizzle" },
        // 站主付費回想的共用用量帳本（#55）；只套用 0004 的用量表，不跑世界 migration。
        { "binding": "RECALL_USAGE_DB", "database_name": "quiet-hours-npc-recall-usage", "database_id": "e3094fff-7aae-4d9b-aa66-64ca7e196fe7" }
      ],
      // 測試站專用的記憶向量索引；1536 維 cosine，metadata index 見 docs/design/recall-service-configuration.md。
      // 有 binding 不等於啟用：RECALL_ENABLED、OWNER_EMBEDDING_KEY 另以 Worker secret 設定。
      "vectorize": [
        { "binding": "MEMORY_VECTOR_INDEX", "index_name": "quiet-hours-npc-test-memory" }
      ]
    },
    "production": {
      "name": "quiet-hours-npc",
      "vars": { "APP_ENV": "production", "AUTH_ORIGIN": "https://quiet-hours-npc.houmengkou.workers.dev", "GITHUB_ALLOWED_IDS": "89203678" },
      "d1_databases": [
        { "binding": "DB", "database_name": "quiet-hours-npc-world", "database_id": "a2caa468-dcdd-4628-8ead-ded3eba4d10c", "migrations_dir": "drizzle" }
      ]
    }
  }
}
